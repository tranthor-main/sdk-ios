{
  "id": "persistence-retry-restart",
  "description": "An in-flight batch waiting to retry survives restart and retains its original messageId and timestamp.",
  "capabilities": [
    "core",
    "persistence"
  ],
  "config": {
    "writeKey": "Basic MDAwMDAwMDAtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDAwOmNvbmZvcm1hbmNl",
    "flushIntervalMs": 5000,
    "baseDelay": 5000,
    "retries": 3,
    "batchSize": 1
  },
  "server": {
    "responses": [
      {
        "status": 500
      },
      {
        "status": 204
      }
    ]
  },
  "steps": [
    {
      "op": "emit",
      "call": "a",
      "method": "track",
      "data": {
        "userId": "user-1",
        "event": "event-a"
      }
    },
    {
      "op": "assert",
      "expect": {
        "requests": [
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          }
        ],
        "errors": []
      },
      "observeMs": 10
    },
    {
      "op": "restart",
      "label": "restart"
    },
    {
      "op": "wait",
      "ms": 1100
    },
    {
      "op": "flush"
    },
    {
      "op": "assert",
      "expect": {
        "requests": [
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          },
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          }
        ],
        "errors": [],
        "delays": [
          {
            "from": 0,
            "to": 1,
            "minMs": 0,
            "maxMs": 4000
          }
        ],
        "restartBetween": [
          {
            "label": "restart",
            "from": 0,
            "to": 1
          }
        ]
      }
    }
  ]
}