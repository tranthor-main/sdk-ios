{
  "id": "durable-exhausted-batch-retained",
  "description": "An exhausted retryable batch is kept without an error callback, and the next explicit flush delivers it.",
  "capabilities": [
    "core",
    "durable-queue"
  ],
  "config": {
    "writeKey": "Basic MDAwMDAwMDAtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDAwOmNvbmZvcm1hbmNl",
    "flushIntervalMs": 1000,
    "baseDelay": 80,
    "retries": 2
  },
  "server": {
    "responses": [
      {
        "status": 500
      },
      {
        "status": 500
      },
      {
        "status": 500
      },
      {
        "status": 204
      }
    ]
  },
  "steps": [
    {
      "op": "emit",
      "call": "a",
      "method": "track",
      "data": {
        "userId": "user-1",
        "event": "event-a"
      }
    },
    {
      "op": "flush",
      "rejected": true
    },
    {
      "op": "assert",
      "expect": {
        "requests": [
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          },
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          },
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          }
        ],
        "errors": []
      }
    },
    {
      "op": "flush",
      "rejected": false
    },
    {
      "op": "assert",
      "expect": {
        "requests": [
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          },
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          },
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          },
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          }
        ],
        "errors": []
      }
    }
  ]
}
