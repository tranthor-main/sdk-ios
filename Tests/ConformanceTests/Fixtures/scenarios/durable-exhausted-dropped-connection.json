{
  "id": "durable-exhausted-dropped-connection",
  "description": "A batch whose attempts all ended in dropped connections is kept and delivered by the next flush.",
  "capabilities": [
    "core",
    "transport",
    "durable-queue"
  ],
  "config": {
    "writeKey": "Basic MDAwMDAwMDAtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDAwOmNvbmZvcm1hbmNl",
    "batchSize": 1,
    "baseDelay": 80,
    "retries": 1
  },
  "server": {
    "responses": [
      {
        "drop": true
      },
      {
        "drop": true
      },
      {
        "status": 204
      }
    ]
  },
  "steps": [
    {
      "op": "emit",
      "call": "a",
      "method": "track",
      "data": {
        "userId": "user-1",
        "event": "event-a"
      }
    },
    {
      "op": "flush",
      "rejected": true
    },
    {
      "op": "assert",
      "expect": {
        "requests": [
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          },
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          }
        ],
        "errors": [],
        "delays": [
          {
            "from": 0,
            "to": 1,
            "minMs": 65,
            "maxMs": 600
          }
        ]
      }
    },
    {
      "op": "flush",
      "rejected": false
    },
    {
      "op": "assert",
      "expect": {
        "requests": [
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          },
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          },
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          }
        ],
        "errors": []
      }
    }
  ]
}
