                "call": "a"
              }
            ]
          },
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          },
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          }
        ],
        "errors": [],
        "delays": [
          {
            "from": 0,
            "to": 1,
            "minMs": 285,
            "maxMs": 560
          },
          {
            "from": 1,
            "to": 2,
            "minMs": 585,
            "maxMs": 900
          },
          {
            "from": 2,
            "to": 3,
