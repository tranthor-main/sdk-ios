{
  "id": "identity-token-token-supplied-once-is-held-after-refusal",
  "description": "A token given once through identify puts identity in use, even with no provider and after the refusal deleted the cached token: the refused batch is held and a later event of the same user is held too, never dropped. (Remembering this across a restart is covered by PROTOCOL for SDKs that persist state.)",
  "capabilities": [
    "core",
    "transport",
    "identity-token"
  ],
  "config": {
    "writeKey": "Basic MDAwMDAwMDAtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDAwOmNvbmZvcm1hbmNl"
  },
  "server": {
    "responses": [],
    "identity": {
      "mode": "required"
    }
  },
  "steps": [
    {
      "op": "emit",
      "call": "a",
      "method": "identify",
      "data": {
        "userId": "user-1"
      },
      "identityToken": {
        "ref": "t1",
        "sub": "user-1",
        "ttlSeconds": 3600,
        "valid": false
      }
    },
    {
      "op": "assert",
      "observeMs": 300,
      "expect": {
        "requests": [
          {
            "batch": [
              {
                "call": "a"
              }
            ],
            "identityTokens": [
              "t1"
            ]
          }
        ],
        "errors": [],
        "notices": [
          {
            "kind": "identity-refused",
            "reason": "signature"
          }
        ]
      }
    },
    {
      "op": "emit",
      "call": "b",
      "method": "track",
      "data": {
        "userId": "user-1",
        "event": "event-b"
      }
    },
    {
      "op": "flush",
      "rejected": true
    },
    {
      "op": "assert",
      "observeMs": 300,
      "expect": {
        "requests": [
          {
            "batch": [
              {
                "call": "a"
              }
            ],
            "identityTokens": [
              "t1"
            ]
          },
          {
            "batch": [
              {
                "call": "a"
              },
              {
                "call": "b"
              }
            ],
            "identityTokens": []
          }
        ],
        "errors": [],
        "providerCalls": [],
        "notices": [
          {
            "kind": "identity-refused",
            "reason": "signature"
          },
          {
            "kind": "identity-refused",
            "reason": "missing"
          }
        ]
      }
    }
  ]
}
