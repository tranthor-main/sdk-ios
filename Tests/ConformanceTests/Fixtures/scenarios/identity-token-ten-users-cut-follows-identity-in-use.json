{
  "id": "identity-token-ten-users-cut-follows-identity-in-use",
  "description": "The cut at ten distinct users per request follows identity in use, not the token cache: with no provider, a token passed once through identify and then refused (cache emptied), more than ten queued users are still sent in requests of at most ten users.",
  "capabilities": [
    "core",
    "transport",
    "identity-token"
  ],
  "config": {
    "writeKey": "Basic MDAwMDAwMDAtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDAwOmNvbmZvcm1hbmNl",
    "batchSize": 12
  },
  "server": {
    "responses": [
      {
        "status": 403,
        "body": {
          "code": "identity_not_verified",
          "message": "Identity token missing or invalid for 1 user.",
          "reason": "signature",
          "userIds": [
            "user-1"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "op": "emit",
      "call": "a",
      "method": "identify",
      "data": {
        "userId": "user-1"
      },
      "identityToken": {
        "ref": "t1",
        "sub": "user-1",
        "ttlSeconds": 3600
      }
    },
    {
      "op": "assert",
      "observeMs": 300,
      "expect": {
        "requests": [
          {
            "batch": [
              {
                "call": "a"
              }
            ],
            "identityTokens": [
              "t1"
            ]
          }
        ],
        "errors": [],
        "providerCalls": [],
        "notices": [
          {
            "kind": "identity-refused",
            "reason": "signature"
          }
        ]
      }
    },
    {
      "op": "emit",
      "call": "u2",
      "method": "track",
      "data": {
        "userId": "user-2",
        "event": "event"
      }
    },
    {
      "op": "emit",
      "call": "u3",
      "method": "track",
      "data": {
        "userId": "user-3",
        "event": "event"
