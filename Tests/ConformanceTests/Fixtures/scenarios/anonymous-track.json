{
  "id": "anonymous-track",
  "description": "Anonymous track carries anonymousId, event and properties without a userId.",
  "capabilities": [
    "core"
  ],
  "config": {
    "writeKey": "Basic MDAwMDAwMDAtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDAwOmNvbmZvcm1hbmNl",
    "flushIntervalMs": 1000,
    "baseDelay": 80,
    "retries": 3
  },
  "server": {
    "responses": []
  },
  "steps": [
    {
      "op": "emit",
      "call": "a",
      "method": "track",
      "data": {
        "anonymousId": "anon-1",
        "event": "Opened",
        "properties": {
          "source": "app"
        }
      }
    },
    {
      "op": "flush",
      "rejected": false
    },
    {
      "op": "assert",
      "expect": {
        "requests": [
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          }
        ],
        "errors": []
      }
    }
  ]
}
