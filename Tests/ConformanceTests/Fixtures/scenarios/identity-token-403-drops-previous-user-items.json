{
  "id": "identity-token-403-drops-previous-user-items",
  "description": "A 403 for a user who is no longer current removes only that user's items and reports them through onError; the current user's items are sent.",
  "capabilities": [
    "core",
    "transport",
    "identity-token"
  ],
  "config": {
    "writeKey": "Basic MDAwMDAwMDAtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDAwOmNvbmZvcm1hbmNl",
    "batchSize": 2,
    "identity": {
      "provider": []
    }
  },
  "server": {
    "responses": [],
    "identity": {
      "mode": "required"
    }
  },
  "steps": [
    {
      "op": "emit",
      "call": "a",
      "method": "identify",
      "data": {
        "userId": "user-1"
      },
      "identityToken": {
        "ref": "t1",
        "sub": "user-1",
        "ttlSeconds": 3600,
        "valid": false
      }
    },
    {
      "op": "emit",
      "call": "b",
      "method": "identify",
      "data": {
        "userId": "user-2"
      },
      "identityToken": {
        "ref": "t2",
        "sub": "user-2",
        "ttlSeconds": 3600
      }
    },
    {
      "op": "flush",
      "rejected": false
    },
    {
      "op": "assert",
      "expect": {
        "errors": [
          {
            "attempts": 1,
            "status": 403,
            "eventCalls": [
              "a"
            ]
          }
        ],
        "requests": [
          {
            "batch": [
              {
                "call": "a"
              },
              {
                "call": "b"
              }
            ],
            "identityTokens": [
              "t1",
              "t2"
            ]
          },
          {
            "batch": [
              {
                "call": "b"
              }
            ],
            "identityTokens": [
              "t2"
            ]
          }
        ],
        "providerCalls": []
      }
    }
  ]
}
