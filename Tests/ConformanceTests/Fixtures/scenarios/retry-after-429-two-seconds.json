{
  "id": "retry-after-429-two-seconds",
  "description": "Retry-After may exceed one second; a client must not impose a one-second cap.",
  "capabilities": [
    "core",
    "transport"
  ],
  "config": {
    "writeKey": "Basic MDAwMDAwMDAtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDAwOmNvbmZvcm1hbmNl",
    "flushIntervalMs": 1000,
    "baseDelay": 80,
    "retries": 3
  },
  "server": {
    "responses": [
      {
        "status": 429,
        "retryAfter": "2"
      },
      {
        "status": 204
      }
    ]
  },
  "steps": [
    {
      "op": "emit",
      "call": "a",
      "method": "track",
      "data": {
        "userId": "user-1",
        "event": "event-a"
      }
    },
    {
      "op": "flush",
      "rejected": false
    },
    {
      "op": "assert",
      "expect": {
        "requests": [
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          },
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          }
        ],
        "errors": [],
        "delays": [
          {
            "from": 0,
            "to": 1,
            "minMs": 1900,
            "maxMs": 3000
          }
        ]
      }
    }
  ]
}
