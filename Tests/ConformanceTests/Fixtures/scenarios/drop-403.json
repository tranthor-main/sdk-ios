{
  "id": "drop-403",
  "description": "HTTP 403 is dropped without retry and reported exactly once with attempts=1.",
  "capabilities": [
    "core"
  ],
  "config": {
    "writeKey": "Basic MDAwMDAwMDAtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDAwOmNvbmZvcm1hbmNl",
    "flushIntervalMs": 1000,
    "baseDelay": 80,
    "retries": 3
  },
  "server": {
    "responses": [
      {
        "status": 403
      }
    ]
  },
  "steps": [
    {
      "op": "emit",
      "call": "a",
      "method": "track",
      "data": {
        "userId": "user-1",
        "event": "event-a"
      }
    },
    {
      "op": "flush",
      "rejected": true
    },
    {
      "op": "assert",
      "expect": {
        "requests": [
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          }
        ],
        "errors": [
          {
            "attempts": 1,
            "eventCalls": [
              "a"
            ],
            "status": 403
          }
        ]
      },
      "observeMs": 220
    }
  ]
}
