{
  "id": "identity-token-unfixable-refusal-does-not-loop",
  "description": "A token just obtained from the provider and refused again is not renewed again in the same send: the SDK reports the server's reason and holds the batch.",
  "capabilities": [
    "core",
    "transport",
    "identity-token"
  ],
  "config": {
    "writeKey": "Basic MDAwMDAwMDAtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDAwOmNvbmZvcm1hbmNl",
    "flushIntervalMs": 50,
    "identity": {
      "providerBackoffMs": 1500,
      "provider": [
        {
          "result": "token",
          "ref": "t1",
          "sub": "user-1",
          "ttlSeconds": 3600,
          "valid": false
        }
      ]
    }
  },
  "server": {
    "responses": [],
    "identity": {
      "mode": "required"
    }
  },
  "steps": [
    {
      "op": "emit",
      "call": "a",
      "method": "identify",
      "data": {
        "userId": "user-1"
      }
    },
    {
      "op": "assert",
      "observeMs": 500,
      "expect": {
        "requests": [
          {
            "batch": [
              {
                "call": "a"
              }
            ],
            "identityTokens": [
              "t1"
            ]
          }
        ],
        "errors": [],
        "providerCalls": [
          "user-1"
        ],
        "notices": [
          {
            "kind": "identity-refused",
            "reason": "signature"
          }
        ]
      }
    }
  ]
}
