{
  "id": "durable-exhausted-batch-keeps-order",
  "description": "Batches queued behind an exhausted batch are not sent before it; the next flush sends them in order.",
  "capabilities": [
    "core",
    "durable-queue"
  ],
  "config": {
    "writeKey": "Basic MDAwMDAwMDAtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDAwOmNvbmZvcm1hbmNl",
    "batchSize": 1,
    "flushIntervalMs": 1000,
    "baseDelay": 80,
    "retries": 1
  },
  "server": {
    "responses": [
      {
        "status": 500
      },
      {
        "status": 500
      },
      {
        "status": 204
      },
      {
        "status": 204
      }
    ]
  },
  "steps": [
    {
      "op": "emit",
      "call": "a",
      "method": "track",
      "data": {
        "userId": "user-1",
        "event": "event-a"
      }
    },
    {
      "op": "emit",
      "call": "b",
      "method": "track",
      "data": {
        "userId": "user-1",
        "event": "event-b"
      }
    },
    {
      "op": "flush",
      "rejected": true
    },
    {
      "op": "assert",
      "expect": {
        "requests": [
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          },
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          }
        ],
        "errors": []
      }
    },
    {
      "op": "flush",
      "rejected": false
    },
    {
      "op": "assert",
      "expect": {
        "requests": [
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          },
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          },
          {
            "batch": [
              {
                "call": "a"
              }
            ]
          },
          {
            "batch": [
              {
                "call": "b"
              }
            ]
          }
        ],
        "errors": []
      }
    }
  ]
}
