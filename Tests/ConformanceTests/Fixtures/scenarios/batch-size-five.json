{
  "id": "batch-size-five",
  "description": "The default batch size sends exactly five items in invocation order without explicit flush.",
  "capabilities": [
    "core"
  ],
  "config": {
    "writeKey": "Basic MDAwMDAwMDAtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDAwOmNvbmZvcm1hbmNl",
    "flushIntervalMs": 1000,
    "baseDelay": 80,
    "retries": 3
  },
  "server": {
    "responses": []
  },
  "steps": [
    {
      "op": "emit",
      "call": "a",
      "method": "track",
      "data": {
        "userId": "user-1",
        "event": "event-a"
      }
    },
    {
      "op": "emit",
      "call": "b",
      "method": "track",
      "data": {
        "userId": "user-1",
        "event": "event-b"
      }
    },
    {
      "op": "emit",
      "call": "c",
      "method": "track",
      "data": {
        "userId": "user-1",
        "event": "event-c"
      }
    },
    {
      "op": "emit",
      "call": "d",
      "method": "track",
      "data": {
        "userId": "user-1",
        "event": "event-d"
      }
    },
    {
      "op": "emit",
      "call": "e",
      "method": "track",
      "data": {
        "userId": "user-1",
        "event": "event-e"
      }
    },
    {
      "op": "assert",
      "expect": {
        "requests": [
          {
            "batch": [
              {
                "call": "a"
              },
              {
                "call": "b"
              },
              {
                "call": "c"
              },
              {
                "call": "d"
              },
              {
                "call": "e"
              }
            ]
          }
        ],
        "errors": [],
        "delays": [
          {
            "from": "e",
            "to": 0,
            "minMs": 0,
            "maxMs": 800
          }
        ]
      }
    }
  ]
}
